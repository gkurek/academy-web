{
  "name": "academy-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run images:variants",
    "dev": "next dev",
    "prebuild": "npm run check:content && npm run check:media && npm run images:variants",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:index": "tsx -e \"import { generateNewsManifest } from './scripts/generate-news-index.ts'; import { generatePublicationsIndex } from './scripts/generate-publications-index.ts'; generateNewsManifest(); generatePublicationsIndex();\"",
    "check:states": "tsx scripts/check-upcoming-states.ts && tsx scripts/check-exhibition-states.ts",
    "check:visual": "tsx scripts/visual-check.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:media": "tsx scripts/check-media.ts",
    "images:variants": "tsx scripts/generate-image-variants.ts",
    "cf:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@opennextjs/cloudflare": "1.20.13",
    "next": "16.4.3",
    "posthog-js": "^1.441.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "knip": "^6.43.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.153.0"
  }
}

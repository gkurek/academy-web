# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/design

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual regression output (baseline, head, diffs)
/.visual/

# Lighthouse raw reports (~60 MB) stay on disk only; tables live in docs/lighthouse/README.md
/docs/lighthouse/**/*.report.*

# WebP variants of public/media, generated in predev/prebuild (11b)
/public/media-webp/

# OpenNext / Cloudflare build output and local state
/.open-next/
/.wrangler/

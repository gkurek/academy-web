{
  // Next.js on Cloudflare Workers via OpenNext (K-09). Builds and deploys: Workers Builds (K-161).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akademiaikony",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "akademiaikony"
    }
  ],
  // No Cloudflare Images binding: next/image serves WebP variants prebuilt into static assets (11b).
  // Workers Logs + Issues: 5xx, exceptions and CPU limit errors grouped in the dashboard (K-162).
  // Issues must stay enabled here, otherwise the next deploy turns it off.
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  },
  // Worker Previews for non-production branches (K-161): bindings are not inherited from the top level.
  // WORKER_SELF_REFERENCE is left out on purpose: in a Preview it would call the production Worker.
  "previews": {
    "observability": {
      "enabled": true
    }
  }
}

{
  // Next.js on Cloudflare Workers via OpenNext (K-09). Builds and deploys: Workers Builds (K-161).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akademiaikony",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "akademiaikony"
    }
  ],
  // next/image optimization through Cloudflare Images; revisited in 11b (image loading)
  "images": {
    "binding": "IMAGES"
  },
  // Workers Logs (K-162)
  "observability": {
    "enabled": true
  },
  // Worker Previews for non-production branches (K-161): bindings are not inherited from the top level.
  // WORKER_SELF_REFERENCE is left out on purpose: in a Preview it would call the production Worker.
  "previews": {
    "images": {
      "binding": "IMAGES"
    },
    "observability": {
      "enabled": true
    }
  }
}

# Cache rules for Workers static assets (11b). Worker responses (HTML, /_next/image) are not affected.

# Content-hashed build output: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media and their WebP variants keep their path when replaced, so the browser cache is kept short.
/media/*
  Cache-Control: public, max-age=86400

/media-webp/*
  Cache-Control: public, max-age=86400
